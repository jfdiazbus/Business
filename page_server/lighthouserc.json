{
  "ci": {
    "collect": {
      "startServerCommand": "PORT=3200 node index.js",
      "startServerReadyPattern": "portfolio ready",
      "url": [
        "http://127.0.0.1:3200/",
        "http://127.0.0.1:3200/home",
        "http://127.0.0.1:3200/school",
        "http://127.0.0.1:3200/services",
        "http://127.0.0.1:3200/terms",
        "http://127.0.0.1:3200/thanks",
        "http://127.0.0.1:3200/login",
        "http://127.0.0.1:3200/register"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["is-crawlable"],
        "chromeFlags": ["--force-prefers-reduced-motion"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.9 }]
      }
    }
  }
}
