{
  "name": "page_server",
  "version": "1.0.0",
  "description": "Portfolio and blog on Cloudflare Workers, with static pages, D1 posts and R2 media.",
  "type": "module",
  "private": true,
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "dev:worker": "pnpm build && wrangler dev",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "stripe": "^23.0.0"
  }
}
