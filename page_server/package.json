{
  "name": "page_server",
  "version": "1.0.0",
  "description": "Portfolio and blog on Cloudflare Workers, with static pages, D1 posts and R2 media.",
  "type": "module",
  "private": true,
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "dev:worker": "pnpm build && wrangler dev",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"*.css\"",
    "lint:html": "html-validate \"*.html\"",
    "lint:md": "markdownlint-cli2 \"*.md\"",
    "lint:spell": "cspell --no-progress .",
    "lint": "pnpm lint:js && pnpm lint:css && pnpm lint:html && pnpm lint:md && pnpm lint:spell",
    "coverage": "vitest run --coverage",
    "size": "size-limit",
    "knip": "knip",
    "types": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.2.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "cspell": "^10.4.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "html-validate": "^11.16.4",
    "jsdom": "^30.1.2",
    "knip": "^6.42.1",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.10",
    "size-limit": "^14.2.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "stripe": "^23.0.0"
  }
}
